{
  "name": "@lk-robotics/lds-3d",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "clean": "pnpm -r --if-present run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm check:lds-style && eslint . && pnpm boundary && pnpm exports:check && pnpm api-report:check",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "storybook": "storybook dev --config-dir apps/docs/.storybook --port 6007 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build --config-dir apps/docs/.storybook --output-dir storybook-static && node scripts/check-storybook.mjs && pnpm check:representative-stories",
    "check:lds-style": "node scripts/check-lds-style.mjs",
    "check:representative-stories": "node scripts/check-lds-style.mjs --storybook-index storybook-static/index.json --require-built-stories",
    "visual-alpha:runtime-qa": "node scripts/verify-visual-alpha-runtime.mjs",
    "api-report": "node scripts/generate-api-report.mjs",
    "api-report:check": "node scripts/generate-api-report.mjs --check",
    "boundary": "dependency-cruiser --config dependency-cruiser.cjs packages apps/docs/src scripts",
    "exports:check": "node scripts/check-package-exports.mjs",
    "publint": "node scripts/check-package-publint.mjs",
    "attw": "node scripts/check-package-types.mjs",
    "evidence": "node scripts/generate-evidence.mjs",
    "package-smoke": "node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@arethetypeswrong/core": "0.18.2",
    "@changesets/cli": "2.29.7",
    "@eslint/js": "9.39.1",
    "@microsoft/api-extractor": "7.52.11",
    "@storybook/addon-a11y": "9.1.10",
    "@storybook/react-vite": "9.1.10",
    "@types/node": "24.10.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "dependency-cruiser": "17.3.1",
    "eslint": "9.39.1",
    "fast-check": "4.3.0",
    "prettier": "3.6.2",
    "publint": "0.3.15",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "storybook": "9.1.10",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
