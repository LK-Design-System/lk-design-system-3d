{
  "name": "@lk-design-system/lds-3d-r3f",
  "version": "0.1.0-alpha.1",
  "description": "React Three Fiber WebGL renderer for LK Design System 3D scenes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./coordinates": {
      "types": "./dist/coordinates.d.ts",
      "import": "./dist/coordinates.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "import": "./dist/themes.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "import": "./dist/scene.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "api-report": "api-extractor run --local"
  },
  "dependencies": {
    "@lk-design-system/lds-3d-assets": "workspace:*",
    "@lk-design-system/lds-3d-core": "workspace:*",
    "@lk-design-system/lds-3d-markers": "workspace:*",
    "@lk-design-system/lds-3d-pointcloud": "workspace:*",
    "@lk-design-system/lds-3d-three": "workspace:*"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.6.1",
    "react": ">=19.1.1 <20",
    "three": ">=0.185.1 <1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@react-three/fiber": "9.6.1",
    "@types/react": "19.1.16",
    "@types/three": "0.185.1",
    "react": "19.1.1",
    "three": "0.185.1",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
